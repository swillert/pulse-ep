# ============================================================================
# pulse-ep — example environment file
# ----------------------------------------------------------------------------
# Copy this file to `.env` and adjust values for your local environment.
# All variables follow the pattern PULSE_EP_<FIELD-IN-UPPERCASE>.
# Boolean values accept: 1/0, true/false, yes/no, on/off.
# Lists accept a comma-separated string.
# ============================================================================

# --- Database ---------------------------------------------------------------
# Option A — provide a full SQLAlchemy URL (takes precedence over the
# individual component variables below):
PULSE_EP_DATABASE_URL=postgresql://pulse:pulse@localhost:5432/pulse

# Option B — provide individual components (useful when only the password
# lives in a secret store and the rest is plaintext):
# PULSE_EP_DATABASE_USER=pulse
# PULSE_EP_DATABASE_PASSWORD=pulse
# PULSE_EP_DATABASE_HOST=localhost
# PULSE_EP_DATABASE_PORT=5432
# PULSE_EP_DATABASE_NAME=pulse

# --- HTTP server ------------------------------------------------------------
PULSE_EP_HOST=127.0.0.1
PULSE_EP_PORT=5000
PULSE_EP_DEBUG=0

# --- Security ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
PULSE_EP_JWT_SECRET_KEY=replace-me-with-a-random-48-byte-token

# bcrypt cost factor (log2 rounds). 12 ≈ 250 ms per hash on a 2024 laptop.
PULSE_EP_BCRYPT_LOG_ROUNDS=12

# Comma-separated list of allowed CORS origins. "*" matches everything.
PULSE_EP_CORS_ORIGINS=*

# --- Application ------------------------------------------------------------
PULSE_EP_REPORTS_DIR=reports

# --- Import queue -----------------------------------------------------
# Directory the import watcher scans for new export bundles (folders/ZIPs).
PULSE_EP_DROP_DIR=drop
# Root for Parquet waveform storage. Leave empty to disable waveform import
# through the queue (the CLI takes --store-dir instead).
PULSE_EP_WAVEFORM_STORE_DIR=
# Whether this deployment serves the MCP server (AI access, read-only).
# Opt-in: off unless this is 1, and off again on anything unrecognised, so a
# typo cannot switch AI access on. While it is off, requests that identify
# themselves as MCP are refused and pulse-ep-mcp will not start against this
# deployment. Read by both ends, so one setting covers both when they share
# an environment.
#
# Turning it on means study data leaves this deployment for a language model,
# in most setups a third-party service. Establish first what you are allowed
# to send — institutional policy, the terms the data was collected under, the
# agreement with the AI provider — and where those ask for more than the
# anonymiser removes, adapt what is sent before enabling it.
# This gate applies to clients that identify themselves as MCP. Ordinary
# API credentials still grant API access. Removing an account prevents new
# logins; already issued access tokens remain valid until they expire.
PULSE_EP_MCP_ENABLED=0
