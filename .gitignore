# Data paths (never commit patient-identifiable data)
# The GitHub mirror force-pushes every commit on main to a public repo,
# so anything committed here is published irreversibly.
data/
drop/
# Clinical exports as they arrive from the lab. A 208 GB tree of these
# appeared in the working directory while this repository was being
# released; it was not covered by any pattern here, and a plain `git add -A`
# would have staged all of it.
raw_data/
raw-data/
exports/
# Plots the example clients write when run against real data — patient-derived
# output, and regenerated on every run.
examples/**/*.png
examples/**/*.pdf
# local working notes, not part of the published repo
CLAUDE.md
*.zip
*.7z
study.csv
studies.csv
*.patient.csv

